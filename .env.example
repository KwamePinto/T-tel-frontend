# ---------------------------------------------------------------------------
# Frontend (Vite). Everything here is compiled into the bundle and is public —
# never put a secret in this file.
# ---------------------------------------------------------------------------

# Where the API lives. In local development that is the backend on port 5000;
# on Render it is the backend service's URL, e.g.
#   https://ttel-api.onrender.com
VITE_API_URL=http://localhost:5000

# The site's own public URL. Used for canonical links and the sitemap.
VITE_SITE_URL=http://localhost:5173

# Public base URL of the media bucket, e.g.
#   https://pub-xxxxxxxx.r2.dev
# or a custom domain in front of it. Uploads are then fetched straight from
# the CDN instead of through the API, which saves a redirect per image.
# Leave blank when running the backend on local disk storage.
VITE_MEDIA_URL=
